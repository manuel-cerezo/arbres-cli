{
  "name": "arbres-cli",
  "version": "0.1.0",
  "description": "Pregunta a los árboles de Barcelona y L'Hospitalet desde la terminal o desde tu agente. Datos de arbres.barcelona.",
  "type": "module",
  "bin": {
    "arbres": "dist/cli.js",
    "arbres-cli": "dist/cli.js"
  },
  "files": ["dist", "README.md", "LICENSE", "DATOS.md"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx src/cli.ts"
  },
  "keywords": ["barcelona", "arbres", "árboles", "trees", "open-data", "cli", "agent"],
  "license": "MIT",
  "author": "Manuel Cerezo",
  "repository": { "type": "git", "url": "git+https://github.com/manuel-cerezo/arbres-cli.git" },
  "homepage": "https://arbres.barcelona",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
